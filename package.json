{
  "name": "slush-ai-reader",
  "version": "0.3.2",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "build": "wxt build && node scripts/copy-build.mjs",
    "zip": "wxt zip && node scripts/copy-build.mjs --zip",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:browser": "node scripts/browser-check.mjs",
    "postinstall": "wxt prepare",
    "test:startup": "node scripts/startup-check.mjs --assert"
  },
  "dependencies": {
    "@mozilla/readability": "^0.6.0",
    "idb-keyval": "^6.3.0",
    "lucide": "^0.468.0",
    "openai": "^6.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/chrome": "^0.1.0",
    "@types/node": "^24.0.0",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^27.0.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0",
    "wxt": "^0.20.0"
  }
}
